generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  operations   Operation[]
  extras       Extra[]
  bank         Bank?
}

model Operation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  time        String
  competition String
  game        String
  stake       Float
  payout      Float
  doubleGreen String
  profit      Float
  result      Float
  notes       String?
  fixtureId   Int?
  league      String?
  createdAt   DateTime @default(now())
  @@index([userId, date, time])
}

model Extra {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  time      String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
  @@index([userId, date, time])
}

model Bank {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialValue Float
  updatedAt    DateTime @default(now())
}