# Copie para .env e preencha. NUNCA commite o .env real.
# PostgreSQL gerenciado (Neon/Vercel Postgres)
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco?sslmode=require"

# Assinatura do JWT — use um valor longo e aleatório
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Chave da API de esportes (opcional)
VITE_RAPIDAPI_KEY=""